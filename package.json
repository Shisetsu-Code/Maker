{
  "name": "rushybet-replica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "npm run build",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:runtime": "node --test tests/runtime-smoke.mjs",
    "check:assets": "node scripts/check-assets.mjs --strict",
    "lint": "eslint src scripts tools/reconstruction public/muestra --ignore-pattern demo-assets-map.js",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "check": "npm run build && npm run lint && npm test && npm run check:assets"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.8",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.8",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
