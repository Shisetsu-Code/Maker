/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/muestra/vista-azul.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'
/muestra/vista-blaze.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'
/muestra/vista-brasa.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'

/muestra/*.js
  Cache-Control: public, max-age=3600, must-revalidate
/muestra/*.mjs
  Cache-Control: public, max-age=3600, must-revalidate
/muestra/*.css
  Cache-Control: public, max-age=3600, must-revalidate
/muestra/*.html
  Cache-Control: public, max-age=3600, must-revalidate
/muestra/*.json
  Cache-Control: public, max-age=3600, must-revalidate
/muestra/:dir/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=604800
/games-cartas/*
  Cache-Control: public, max-age=604800
/games-zitro/*
  Cache-Control: public, max-age=604800
