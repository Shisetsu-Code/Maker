{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rushybet-replica",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-11",
  "account_id": "3904fa9871c00ad145ed8f8f5404d1bd",
  "workers_dev": true,
  "build": { "command": "npm run check:privacy" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/muestra/games-cartas/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
